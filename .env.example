# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# SMTP CONFIGURATION (Pengiriman Email Otomatis)
# ==========================================
# Untuk menggunakan Gmail:
# 1. Pastikan Verifikasi 2 Langkah (2-Step Verification) aktif di Akun Google Anda.
# 2. Buka https://myaccount.google.com/apppasswords
# 3. Buat nama aplikasi baru (misal: "Produktifa"), lalu salin Sandi Aplikasi 16 karakter (App Password).
# 4. Masukkan ke variabel di bawah:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="alamatemailanda@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="Produktifa <alamatemailanda@gmail.com>"
